{
  "name": "result-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "lint:publish": "pnpm --filter \"./packages/*\" exec publint",
    "typecheck": "pnpm --filter @vencav/result build && pnpm -r typecheck",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "publint": "^0.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0"
  }
}
