{
  "name": "@vencav/result",
  "version": "0.1.0",
  "description": "Lightweight, type-safe Result type for TypeScript",
  "keywords": ["result", "typescript", "error-handling", "functional"],
  "author": "Václav Vracovský <vaclavvracovsky@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/VencaV/result#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/VencaV/result.git",
    "directory": "packages/result"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
