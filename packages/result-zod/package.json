{
  "name": "@vencav/result-zod",
  "version": "0.1.1",
  "description": "Zod integration for @vencav/result",
  "keywords": [
    "result",
    "typescript",
    "zod",
    "error-handling"
  ],
  "author": "Václav Vracovský <vaclavvracovsky@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/VencaV/result#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VencaV/result.git",
    "directory": "packages/result-zod"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@vencav/result": ">=0.1.1",
    "zod": ">=3.0.0 <4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vencav/result": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
